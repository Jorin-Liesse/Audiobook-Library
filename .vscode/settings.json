{
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.svelte-kit": true,
    "**/.vite": true,
    "**/.history": true,
    "dist": true,
    "build": true,
    "coverage": true,
    ".output": true,
    ".vercel": true,
    ".netlify": true,
    ".wrangler": true,
    "vite.config.*.timestamp-*": true,
    "**/*.tsbuildinfo": true,
    "**/npm-debug.log*": true,
    ".gitignore": true,
    ".prettierignore": true,
    ".github": true,
    ".vscode": true,
    "package-lock.json": true,
    "package.json": true,
    "prettierrc": true,
    ".npmrc": true,
    ".prettierrc": true,
    "eslint.config.js": true,
    "svelte-options.js": true,
    "tsconfig.json": true,
    "vite.config.ts": true,
    "workspace.code-workspace": true,
    "WorkFiles": true,
    "svelte.config.js": true,
    "vite.config.js": true,
    "scripts": true,
  },

  "svelte.enable-ts-plugin": true
}
