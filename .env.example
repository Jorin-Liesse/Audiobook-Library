# Public OAuth client IDs from the same Google Cloud project.
VITE_GOOGLE_WEB_CLIENT_ID=
# Android AuthorizationClient selects this registration by package name + SHA-1.
# Kept here for reference; the native Android API does not accept a client ID.
VITE_GOOGLE_ANDROID_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_ID=

# From the downloaded Desktop app OAuth configuration, if provided.
# Read only by the Rust build; never use a VITE_ prefix for this value.
GOOGLE_DESKTOP_CLIENT_SECRET=
